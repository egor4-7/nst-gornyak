<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Официальный портал НСТ «Горняк»</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                gornyak: {
                  50: '#f2f9f4',
                  100: '#e1f3e6',
                  200: '#c5e7cd',
                  600: '#1e7e43',
                  700: '#176334',
                  800: '#144f2b',
                  900: '#0f3d22',
                }
              },
              fontFamily: {
                sans: ['Inter', 'sans-serif'],
                heading: ['Montserrat', 'sans-serif'],
              }
            }
          }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Montserrat', sans-serif; }
        .father-hero {
            background: linear-gradient(90deg, rgba(14,62,32,0.92) 0%, rgba(20,79,43,0.75) 50%, rgba(0,0,0,0.2) 100%),
                        url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
        }
        .forest-footer {
            background: linear-gradient(to top, #c5e7cd 0%, #e1f3e6 60%, rgba(255,255,255,0) 100%);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased">

    <!-- Верхняя шапка папиного портала -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto px-4 py-2.5 flex items-center justify-between">
            <a href="father.html" class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-gornyak-700 text-white flex items-center justify-center font-bold text-lg shadow-sm">
                    <i class="fa-solid fa-tree"></i>
                </div>
                <div>
                    <span class="block text-base font-extrabold text-gornyak-900 leading-none">НСТ «Горняк»</span>
                    <span class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider">Официальный портал</span>
                </div>
            </a>
            <div class="flex items-center gap-3">
                <!-- Кнопка возврата на ваш интерфейс -->
                <a href="index.html" class="bg-gornyak-700 hover:bg-gornyak-800 text-white px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-2 shadow transition">
                    <i class="fa-solid fa-shuffle text-yellow-300"></i> Мой интерфейс
                </a>
            </div>
        </div>
    </header>

    <main class="flex-grow">
        <!-- Главный баннер -->
        <div class="father-hero text-white py-12 px-4 relative overflow-hidden">
            <div class="container mx-auto relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                <div>
                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-2 drop-shadow">НСТ «Горняк»</h1>
                    <p class="text-sm sm:text-base text-emerald-100 font-light max-w-xl drop-shadow">
                        Наше СНТ — это наш дом, наши соседи, наша ответственность! Вместе делаем наше СНТ лучше!
                    </p>
                </div>
                <div class="bg-white/95 backdrop-blur text-slate-800 px-4 py-3 rounded-2xl shadow-lg flex items-center gap-3">
                    <i class="fa-solid fa-sun text-yellow-500 text-2xl animate-spin" style="animation-duration: 20s;"></i>
                    <div>
                        <div class="flex items-center gap-2 font-bold text-base leading-none text-slate-900">
                            +18°C <span class="text-[9px] font-normal text-slate-500">Московская область</span>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-1">Ясно • Ветер 3 м/с</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Навигационные карточки папиного сайта -->
        <div class="container mx-auto px-4 py-8 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="text-gornyak-700 text-2xl mb-3"><i class="fa-solid fa-tree"></i></div>
                    <h3 class="font-bold text-slate-900 text-base mb-1">О СНТ</h3>
                    <p class="text-slate-500 text-xs">История товарищества, документы и общая информация</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="text-gornyak-700 text-2xl mb-3"><i class="fa-solid fa-bus"></i></div>
                    <h3 class="font-bold text-slate-900 text-base mb-1">Транспорт</h3>
                    <p class="text-slate-500 text-xs">Расписание рейсовых автобусов и маршрутов</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="text-gornyak-700 text-2xl mb-3"><i class="fa-solid fa-bolt"></i></div>
                    <h3 class="font-bold text-slate-900 text-base mb-1">Тарифы</h3>
                    <p class="text-slate-500 text-xs">Актуальные расценки на электроэнергию и взносы</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="text-gornyak-700 text-2xl mb-3"><i class="fa-solid fa-bullhorn"></i></div>
                    <h3 class="font-bold text-slate-900 text-base mb-1">Новости</h3>
                    <p class="text-slate-500 text-xs">Важные объявления правления и собрания</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Фирменный подвал -->
    <footer class="forest-footer pt-10 pb-6 text-xs text-slate-700 border-t border-gornyak-200 mt-10">
        <div class="container mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="font-serif italic font-bold text-gornyak-900 text-base">Вместе — мы сильнее!</div>
            <div>© 2026 НСТ «Горняк» Московская область. Все права защищены.</div>
        </div>
    </footer>

</body>
</html>
